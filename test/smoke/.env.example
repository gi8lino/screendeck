# Optional image overrides for the local smoke stack.
JELLYFIN_IMAGE=jellyfin/jellyfin:latest
PLEX_IMAGE=plexinc/pms-docker:latest
TZ=UTC

# Optional but recommended for a fresh Plex smoke environment.
# Create a short-lived claim token at https://www.plex.tv/claim/ immediately
# before running `make smoke-up` for the first time.
PLEX_CLAIM=
